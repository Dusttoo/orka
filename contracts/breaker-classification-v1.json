{
  "schema_version": 1,
  "contract_id": "orka.breaker-classification",
  "description": "Canonical classification for Orka admission, parking, route-hold, and global stop conditions.",
  "classes": {
    "ticket_retry_wait": {
      "scope": "ticket",
      "strength": "soft",
      "durable_state": "retry_wait",
      "wake_condition": "authenticated retry deadline elapses",
      "authority": "controller",
      "required_evidence": ["attempt_identity", "failure_receipt", "retry_at"],
      "global_transition": false,
      "immutable_hard": false
    },
    "ticket_recovery": {
      "scope": "ticket",
      "strength": "soft",
      "durable_state": "recovery_ready",
      "wake_condition": "recovery eligibility contract passes",
      "authority": "controller",
      "required_evidence": ["attempt_identity", "terminal_receipt", "preservation_digest"],
      "global_transition": false,
      "immutable_hard": false
    },
    "ticket_decomposition": {
      "scope": "ticket",
      "strength": "soft",
      "durable_state": "decomposition_ready",
      "wake_condition": "authenticated child inventory is ready",
      "authority": "controller",
      "required_evidence": ["scope_artifact_digest"],
      "global_transition": false,
      "immutable_hard": false
    },
    "ticket_external_wait": {
      "scope": "ticket",
      "strength": "soft",
      "durable_state": "parked_external",
      "wake_condition": "authenticated dependency receipt proves resolution",
      "authority": "controller",
      "required_evidence": ["dependency_identity", "dependency_receipt"],
      "global_transition": false,
      "immutable_hard": false
    },
    "ticket_hard_decision": {
      "scope": "ticket",
      "strength": "hard",
      "durable_state": "parked_decision",
      "wake_condition": "ticket-scoped root or operator authority is consumed",
      "authority": "ticket_scoped_operator",
      "required_evidence": ["breaker_receipt", "absolute_ceiling_or_decision"],
      "global_transition": false,
      "immutable_hard": true
    },
    "ticket_irrecoverable": {
      "scope": "ticket",
      "strength": "hard",
      "durable_state": "blocked",
      "wake_condition": "explicit operator requeue proves the prior execution unit absent",
      "authority": "ticket_scoped_operator",
      "required_evidence": ["terminal_receipt", "failure_class"],
      "global_transition": false,
      "immutable_hard": true
    },
    "route_transient_hold": {
      "scope": "route",
      "strength": "soft",
      "durable_state": "route_held",
      "wake_condition": "controller health probe succeeds after retry deadline",
      "authority": "controller",
      "required_evidence": ["route_identity", "incident_id", "retry_at"],
      "global_transition": false,
      "immutable_hard": false
    },
    "route_hard_hold": {
      "scope": "route",
      "strength": "hard",
      "durable_state": "route_held",
      "wake_condition": "operator repairs route and controller health probe succeeds",
      "authority": "route_scoped_operator",
      "required_evidence": ["route_identity", "incident_id", "repair_receipt"],
      "global_transition": false,
      "immutable_hard": true
    },
    "sprint_pressure": {
      "scope": "sprint",
      "strength": "soft",
      "durable_state": "degraded",
      "wake_condition": "admission pressure falls below its declared threshold",
      "authority": "controller",
      "required_evidence": ["pressure_class", "capacity_snapshot"],
      "global_transition": true,
      "immutable_hard": false
    },
    "sprint_wait": {
      "scope": "sprint",
      "strength": "soft",
      "durable_state": "paused",
      "wake_condition": "at least one required route is healthy",
      "authority": "controller",
      "required_evidence": ["route_incidents", "next_probe_at"],
      "global_transition": true,
      "immutable_hard": false
    },
    "sprint_hard_budget": {
      "scope": "sprint",
      "strength": "hard",
      "durable_state": "paused",
      "wake_condition": "root-owned absolute sprint ceiling is raised",
      "authority": "sprint_scoped_root",
      "required_evidence": ["budget_receipt", "absolute_ceiling"],
      "global_transition": true,
      "immutable_hard": true
    },
    "sprint_integrity_stop": {
      "scope": "sprint",
      "strength": "hard",
      "durable_state": "stopped",
      "wake_condition": "a fresh preflight proves repository and durable-state integrity",
      "authority": "host_operator",
      "required_evidence": ["integrity_failure_receipt", "runtime_identity"],
      "global_transition": true,
      "immutable_hard": true
    }
  },
  "stop_sources": [
    {"id": "max_usd_per_run", "class": "ticket_hard_decision", "signal": "usage ledger run ceiling"},
    {"id": "pause_usd_per_ticket", "class": "ticket_hard_decision", "signal": "usage ledger ticket pause threshold"},
    {"id": "max_usd_per_ticket", "class": "ticket_hard_decision", "signal": "usage ledger ticket ceiling"},
    {"id": "max_usd_per_design_phase", "class": "ticket_hard_decision", "signal": "design phase envelope"},
    {"id": "max_usd_per_implementation_phase", "class": "ticket_hard_decision", "signal": "implementation phase envelope"},
    {"id": "max_usd_per_code_review_phase", "class": "ticket_hard_decision", "signal": "code review phase envelope"},
    {"id": "max_usd_per_security_review_phase", "class": "ticket_hard_decision", "signal": "security review phase envelope"},
    {"id": "max_usd_without_progress", "class": "ticket_hard_decision", "signal": "controller no-progress threshold"},
    {"id": "max_model_runs_per_ticket", "class": "ticket_hard_decision", "signal": "usage ledger model-run ceiling"},
    {"id": "max_reviewer_runs_per_ticket", "class": "ticket_hard_decision", "signal": "usage ledger reviewer-run ceiling"},
    {"id": "max_lane_relaunches", "class": "ticket_hard_decision", "signal": "controller relaunch ceiling"},
    {"id": "design_round_limit", "class": "ticket_hard_decision", "signal": "design ledger round ceiling"},
    {"id": "review_fix_cycle_limit", "class": "ticket_hard_decision", "signal": "review ledger repair ceiling"},
    {"id": "review_gate_failed", "class": "ticket_hard_decision", "signal": "required code review gate"},
    {"id": "security_gate_failed", "class": "ticket_hard_decision", "signal": "required security review gate"},
    {"id": "merge_gate_failed", "class": "ticket_hard_decision", "signal": "merge guard"},
    {"id": "destructive_action_required", "class": "ticket_hard_decision", "signal": "destructive-action authority boundary"},
    {"id": "launch_rejected_transient", "class": "ticket_retry_wait", "signal": "worker launch receipt"},
    {"id": "timeout_without_progress", "class": "ticket_retry_wait", "signal": "worker terminal receipt"},
    {"id": "timeout_with_progress", "class": "ticket_recovery", "signal": "worker terminal and progress receipts"},
    {"id": "worker_process_lost", "class": "ticket_recovery", "signal": "execution-unit absence receipt"},
    {"id": "worker_result_invalid", "class": "ticket_recovery", "signal": "terminal-result validation receipt"},
    {"id": "worker_cancelled", "class": "ticket_recovery", "signal": "worker cancellation receipt"},
    {"id": "decomposition_required", "class": "ticket_decomposition", "signal": "scope artifact"},
    {"id": "internal_dependency_wait", "class": "ticket_external_wait", "signal": "controller dependency graph"},
    {"id": "external_dependency_wait", "class": "ticket_external_wait", "signal": "authenticated external dependency"},
    {"id": "launch_rejected_permanent", "class": "ticket_irrecoverable", "signal": "worker launch receipt"},
    {"id": "worker_irrecoverable", "class": "ticket_irrecoverable", "signal": "worker terminal receipt"},
    {"id": "provider_unverified", "class": "route_transient_hold", "signal": "provider health state"},
    {"id": "provider_rate_limited", "class": "route_transient_hold", "signal": "provider health state"},
    {"id": "provider_transport", "class": "route_transient_hold", "signal": "provider health state"},
    {"id": "provider_authentication", "class": "route_hard_hold", "signal": "provider health state"},
    {"id": "provider_incompatible", "class": "route_hard_hold", "signal": "provider health state"},
    {"id": "unfinished_pr_pressure", "class": "sprint_pressure", "signal": "controller work-in-progress limit"},
    {"id": "lane_capacity_pressure", "class": "sprint_pressure", "signal": "supervisor lane capacity"},
    {"id": "heavy_process_pressure", "class": "sprint_pressure", "signal": "supervisor heavy-process capacity"},
    {"id": "all_routes_unavailable", "class": "sprint_wait", "signal": "provider health aggregation"},
    {"id": "max_usd_per_sprint", "class": "sprint_hard_budget", "signal": "usage ledger sprint ceiling"},
    {"id": "preflight_failed", "class": "sprint_integrity_stop", "signal": "captain preflight"},
    {"id": "lease_lost", "class": "sprint_integrity_stop", "signal": "repository lease verification"},
    {"id": "durable_state_invalid", "class": "sprint_integrity_stop", "signal": "supervisor state validation"}
  ],
  "current_ticket_state_compatibility": {
    "pending": null,
    "running": null,
    "completed": null,
    "decomposed": null,
    "needs_decomposition": "ticket_decomposition",
    "needs_repair": null,
    "recoverable": "ticket_recovery",
    "external_blocked": "ticket_external_wait",
    "operator_decision": "ticket_hard_decision",
    "user_action": "ticket_hard_decision",
    "blocked": "ticket_irrecoverable"
  },
  "invariants": {
    "ticket_and_route_breakers_never_stop_supervisor": true,
    "skipped_work_is_non_consuming": true,
    "history_is_never_erased": true,
    "hard_controls_cannot_be_softened": true,
    "unknown_sources_fail_closed": true
  }
}
