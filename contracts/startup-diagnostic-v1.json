{
  "contract_id": "orka.startup-diagnostic",
  "schema_version": 1,
  "description": "Deterministic, sanitized, read-only admission evidence for one elected repository supervisor.",
  "check_order": [
    "runtime_permissions",
    "quick_check",
    "foreign_keys",
    "schema",
    "migration_ledger",
    "repository_identity",
    "canonical_policy",
    "cutover",
    "minimum_version"
  ],
  "statuses": ["pass", "fail", "skipped"],
  "reason_codes": [
    "ok",
    "legacy_not_applicable",
    "legacy_uninitialized",
    "dependency_failed",
    "runtime_path_unavailable",
    "runtime_path_permissions_invalid",
    "database_unavailable",
    "database_permissions_invalid",
    "quick_check_failed",
    "foreign_key_violation",
    "schema_mismatch",
    "migration_ledger_mismatch",
    "repository_identity_invalid",
    "repository_binding_mismatch",
    "canonical_policy_invalid",
    "canonical_policy_binding_mismatch",
    "cutover_marker_invalid",
    "cutover_binding_mismatch",
    "minimum_version_invalid",
    "minimum_version_not_met"
  ],
  "invariants": {
    "read_only": true,
    "receipt_is_deterministic": true,
    "receipt_omits_paths_credentials_and_repository_payloads": true,
    "healthy_requires_no_failed_checks": true,
    "admission_requires_healthy_receipt": true,
    "full_integrity_check_is_not_a_startup_check": true
  }
}
